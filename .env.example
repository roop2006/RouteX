# Copy to .env.docker; keep the native-development .env unchanged.
# Set a unique URL-safe password (letters/digits/_/-).
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD
POSTGRES_USER=routex
POSTGRES_DB=routex_db
FRONTEND_PORT=5173
BACKEND_PORT=8001
# Optional host database access through compose.dev.yml.
POSTGRES_PORT=5434
REDIS_PORT=6379
KAFKA_PORT=9092
TOMTOM_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KAFKA_TRAFFIC_TOPIC=routex-traffic-events
KAFKA_GROUP_ID=routex-postgres-consumer
